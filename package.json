{
  "name": "udl-mobile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite",
    "dev:docker": "vite",
    "dev:railway": "vite --mode railway",
    "build": "vite build --mode railway",
    "build:android": "vite build --mode railway",
    "build:local": "vite build --mode android",
    "build:docker": "vite build --mode android",
    "build:railway": "vite build --mode railway",
    "preview": "vite preview",
    "lint:mobile": "node scripts/check-mobile-env.js railway",
    "lint:mobile:railway": "node scripts/check-mobile-env.js railway",
    "lint:mobile:local": "node scripts/check-mobile-env.js local",
    "cap:sync": "npm run cap:sync:railway",
    "cap:sync:railway": "npm run lint:mobile:railway && npm run build:railway && npx cap sync android",
    "cap:sync:android": "npm run cap:sync:railway",
    "cap:sync:local": "npm run lint:mobile:local && npm run build:local && npx cap sync android",
    "cap:sync:docker": "npm run cap:sync:local",
    "cap:android": "npm run cap:android:railway",
    "cap:android:railway": "npm run cap:sync:railway && npx cap open android",
    "cap:android:local": "npm run cap:sync:local && npx cap open android",
    "cap:android:docker": "npm run cap:android:local",
    "cap:ios": "npm run lint:mobile:railway && npm run build:railway && npx cap sync ios && npx cap open ios",
    "cap:ios:local": "npm run lint:mobile:local && npm run build:local && npx cap sync ios && npx cap open ios",
    "android:run": "npm run android:run:railway",
    "android:run:railway": "npm run cap:sync:railway && npx cap run android",
    "android:run:local": "npm run cap:sync:local && npx cap run android",
    "android:run:docker": "npm run android:run:local",
    "ios:run": "npm run cap:sync:railway && npx cap run ios",
    "icons:generate": "node scripts/generate-app-icons.mjs && npx capacitor-assets generate --assetPath assets && node scripts/fix-android-adaptive-icon.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "axios": "^1.16.1",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "chart.js": "^4.5.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "pinia": "^3.0.4",
    "primeflex": "^3.3.1",
    "primeicons": "^6.0.1",
    "primevue": "^3.53.1",
    "vue": "^3.5.34",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.6.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@vitejs/plugin-vue": "^6.0.6",
    "sharp": "^0.34.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.12"
  }
}
