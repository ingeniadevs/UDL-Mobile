# ── Desarrollo en navegador (npm run dev / dev:local) ────────────────
# Vacío = proxy Vite /api -> Docker local (:5055)
VITE_API_URL=
VITE_DEV_API_PROXY=http://localhost:5055

# ── Perfil Railway (nativo) ──────────────────────────────────────────
# npm run cap:android:railway  |  .\scripts\start-android.ps1 -OpenStudio
# Ver .env.railway

# ── Perfil Docker (nativo / emulador) ────────────────────────────────
# npm run cap:android:local    |  .\scripts\start-android-local.ps1 -OpenStudio
# Ver .env.android → http://10.0.2.2:5055/api
# Celular físico: copiá .env.android.local.example → .env.android.local

VITE_ENABLE_ADMIN=true
VITE_APP_SCHEME=ingeniaclub
# App compartida: no definir VITE_CLUB_ID (login comunitario).
# Build white-label de un club: VITE_CLUB_ID=udl

# Push FCM/APNs: requiere Firebase (google-services.json). Activar solo cuando esté configurado.
VITE_ENABLE_PUSH=false
