# ── Desarrollo en navegador (npm run dev) ─────────────────────────────
# Vacío = proxy Vite /api -> backend local
VITE_API_URL=
VITE_DEV_API_PROXY=http://localhost:5055

# ── Build nativo Android/iOS (Railway) ───────────────────────────────
# Ver .env.railway (usado por npm run cap:sync:android)
# VITE_API_URL=https://udl-backend-production.up.railway.app/api

# ── Build local opcional (backend en tu PC, emulador) ────────────────
# npm run build:local  →  usa .env.android (http://10.0.2.2:5055/api)

VITE_ENABLE_ADMIN=true
VITE_APP_SCHEME=ingeniaclub
VITE_CLUB_ID=udl

# Push FCM/APNs: requiere Firebase (google-services.json). Activar solo cuando esté configurado.
VITE_ENABLE_PUSH=false
