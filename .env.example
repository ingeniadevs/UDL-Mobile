# URL base de la API .NET 8 (incluir /api al final en producción)
# Desarrollo web: dejar vacío para usar proxy Vite (/api -> backend)
VITE_API_URL=

# Proxy del backend en desarrollo (Vite)
VITE_DEV_API_PROXY=http://localhost:5055

# Producción móvil (ejemplo)
# VITE_API_URL=https://api.udl.ingenialabs.ar/api

# Habilitar rutas de administración en la app móvil (false = solo portal socio)
VITE_ENABLE_ADMIN=false

# Deep link / esquema para retorno MercadoPago (debe coincidir con capacitor.config y stores)
VITE_APP_SCHEME=udlclub
